# Deployment profile for spark0 / spark1. Copy to .env on spark0.
WORKER=colum@10.50.0.11
FABRIC_PEER=192.168.100.2
# Both ranks read the existing models export; spill stays on local NVMe.
HF_CACHE=/nfs1
WORKER_WEIGHTS=nfs
NFS_SERVER=10.50.0.1
NFS_PATH=/nvme1
NFS_VOLUME=glm53-tensorfold-hf
ABLIT=1
DENSE=fp8
KV=bf16
TF_GLM_KV_SHARD=1
DRAFTER=dflash2
SPILL_GIB=64
SPILL_DIR=/home/colum/.cache/tensorfold-spill
PARALLEL=4
# The checkpoint's native window; the BF16 pool (~1.8M tokens) affords it. Without this,
# scripts/config.sh picks 163,840 for VISION=1 with BF16 KV and non-q4 dense weights.
CONTEXT=1048576
PORT=8000
# First boot compiles the full CUDA extension set on each Spark.
WAIT_TIMEOUT=3600
# Set HF_TOKEN in the environment or on spark0 in scripts/local.sh; do not commit it.

# Seven-token ceiling with adaptive stop rules; four full 8-row verify windows.
DRAFT_POLICY=fnc7:0.3
TF_GLM_MULTI_WINDOW=32
SHARED_PREFIX=1
TF_GLM_MULTI_LONE=0
TF_GLM_CACHE_ENTRIES=32
MEMORY_RESERVE_GIB=14.5
KV_POOL_GIB=12.5
SPILL_TURNS=4
